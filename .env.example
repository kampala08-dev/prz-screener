# PRZ Scanner — Environment Variables
# =====================================
# Copy file ini ke .env dan isi dengan nilai yang sesuai:
#   cp .env.example .env
#   nano .env

# Telegram Bot Token (dari @BotFather)
TELEGRAM_BOT_TOKEN=your_bot_token_here

# Telegram Chat/Group ID (gunakan angka negatif untuk grup)
TELEGRAM_CHAT_ID=-1001234567890

# --- Lapisan sentimen (opsional, hanya bila pakai --sentiment) ---
# API key MiniMax (dari platform.minimax.io). Kosongkan bila tak dipakai.
MINIMAX_API_KEY=
# Model (default MiniMax-M3 = terpintar). OpenRouter: minimax/minimax-m3
MINIMAX_MODEL=MiniMax-M3
# Base URL OpenAI-compatible. OpenRouter: https://openrouter.ai/api/v1
MINIMAX_BASE_URL=https://api.minimax.io/v1
